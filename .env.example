# Copy to .env and edit. Docker Compose reads .env automatically, but variables
# already set in your shell take precedence.

# Your self-hosted Anki sync server and its SYNC_USER1 credentials.
ANKI_SYNC_URL=
ANKI_USERNAME=
ANKI_PASSWORD=

# Voice to use; run `docker compose run --rm anki-audio-syncer --list-voices` for ids.
# Empty = the engine's first voice.
VOICEVOX_SPEAKER=
